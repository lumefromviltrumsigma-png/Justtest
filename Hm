local HNS_espExitDoorsEnabled = false
local HNS_espExitDoorsThread = nil
local HNS_espExitDoorsObjects = {}

local function HNS_clearExitDoorsESP()
for _, v3 in pairs(HNS_espExitDoorsObjects) do
if v3 then
v3:Destroy()
end
end
table.clear(HNS_espExitDoorsObjects)
end

local function HNS_ToggleExitDoors(enabled)
HNS_espExitDoorsEnabled = enabled and true or false

if HNS_espExitDoorsEnabled then
if HNS_espExitDoorsThread then return end
HNS_espExitDoorsThread = true

task.spawn(function()
while HNS_espExitDoorsEnabled and HNS_espExitDoorsThread do
if HNS_CurrentGameIs("HideAndSeek") then
local hideAndSeekMap = workspace:FindFirstChild("HideAndSeekMap")
hideAndSeekMap = hideAndSeekMap and hideAndSeekMap:FindFirstChild("NEWFIXEDDOORS")
hideAndSeekMap = hideAndSeekMap and hideAndSeekMap:FindFirstChild("Floor1")
hideAndSeekMap = hideAndSeekMap and hideAndSeekMap:FindFirstChild("EXITDOORS")

if hideAndSeekMap then
for _, child in ipairs(hideAndSeekMap:GetChildren()) do
if child.Name == "EXITDOOR" and not child:FindFirstChild("DoorESP") then
local highlight = Instance.new("Highlight")
highlight.Name = "DoorESP"
highlight.FillColor = Color3.new(1, 0, 0)
highlight.OutlineColor = Color3.new(1, 0, 0)
highlight.FillTransparency = 0.5
highlight.OutlineTransparency = 0
highlight.Parent = child
table.insert(HNS_espExitDoorsObjects, highlight)
end
end
end
else
HNS_clearExitDoorsESP()
end

task.wait(1.5)
end

HNS_clearExitDoorsESP()
HNS_espExitDoorsThread = nil
end)
else
HNS_clearExitDoorsESP()
HNS_espExitDoorsThread = nil
end
end

