local RLGL_IsInSafeZone = function()
local character = LocalPlayer.Character
if not character or not character:FindFirstChild("HumanoidRootPart") then
return false
end
local pos = character.HumanoidRootPart.Position

local function inside(p, a, b)
return p.X >= math.min(a.X, b.X) and p.X <= math.max(a.X, b.X)
and p.Z >= math.min(a.Z, b.Z) and p.Z <= math.max(a.Z, b.Z)
end

local inA = inside(pos, Vector3.new(-216, 0, 83), Vector3.new(103, 0, 168))
local inB = inside(pos, Vector3.new(103, 0, 168), Vector3.new(116, 0, 82))
local inC = inside(pos, Vector3.new(115, 0, -578), Vector3.new(-215, 0, -516))
return inA or inB or inC
end

local RLGL_SetPlayerFrozen = function(freeze)
local character = LocalPlayer.Character
if not character then return end
local humanoid = character:FindFirstChild("Humanoid")
if humanoid then
humanoid.WalkSpeed = freeze and 0 or 16
humanoid.JumpPower = freeze and 0 or 50
end
local hrp = character:FindFirstChild("HumanoidRootPart")
if hrp and freeze then
hrp.Velocity = Vector3.zero
end
end

local RLGL_IsRedLight = function()
local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
if not playerGui then return false end
local impactFrames = playerGui:FindFirstChild("ImpactFrames")
if not impactFrames then return false end
local trafficLightEmpty = impactFrames:FindFirstChild("TrafficLightEmpty")
if trafficLightEmpty and trafficLightEmpty.Image == "rbxassetid://88400194373338" then
return true
end
return false
end

local RLGL_AutoStopEnabled = false
local RLGL_FreezeThread = nil
local RLGL_FreezeActive = false

local function RLGL_ToggleFreeze(enabled)
RLGL_AutoStopEnabled = enabled and true or false

if RLGL_AutoStopEnabled then
if RLGL_FreezeThread then return end
RLGL_FreezeThread = true

task.spawn(function()
while RLGL_FreezeThread and RLGL_AutoStopEnabled do
if not RLGL_CurrentGameIs("RedLightGreenLight") then
if RLGL_FreezeActive then
RLGL_SetPlayerFrozen(false)
RLGL_FreezeActive = false
end
else
local isRed = RLGL_IsRedLight()
if isRed and not RLGL_IsInSafeZone() then
if not RLGL_FreezeActive then
RLGL_SetPlayerFrozen(true)
RLGL_FreezeActive = true
end
local character = LocalPlayer.Character
if character then
local humanoid = character:FindFirstChild("Humanoid")
if humanoid then
humanoid.WalkSpeed = 0
humanoid.JumpPower = 0
end
local hrp = character:FindFirstChild("HumanoidRootPart")
if hrp then
hrp.Velocity = Vector3.zero
end
end
elseif RLGL_FreezeActive then
RLGL_SetPlayerFrozen(false)
RLGL_FreezeActive = false
end
end
task.wait(0.1)
end
RLGL_FreezeThread = nil
if RLGL_FreezeActive then
RLGL_SetPlayerFrozen(false)
RLGL_FreezeActive = false
end
end)
else
RLGL_FreezeThread = nil
if RLGL_FreezeActive then
RLGL_SetPlayerFrozen(false)
RLGL_FreezeActive = false
end
end
end

