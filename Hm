local AutoPunchEnabled = false
local _AutoPunchOriginal = nil
local AutoStartLoop = nil
local CachedPrompt = nil
local LastFireTime = 0
local FIRE_COOLDOWN = 3.5

local function find_punch_prompt()
if CachedPrompt and CachedPrompt.Parent and CachedPrompt.Enabled then return CachedPrompt end
CachedPrompt = nil

local searchRoots = {
Workspace:FindFirstChild("Map"),
Workspace:FindFirstChild("Interactive"),
Workspace:FindFirstChild("Objects"),
Workspace:FindFirstChild("Machines"),
Workspace:FindFirstChild("Arcade"),
Workspace,
}

for _, root in ipairs(searchRoots) do
if not root then continue end
local prompt = root:FindFirstChild("PunchPrompt", true)
or root:FindFirstChild("StrengthPrompt", true)
or root:FindFirstChild("TestPrompt", true)
if prompt and prompt:IsA("ProximityPrompt") then
CachedPrompt = prompt
return prompt
end
end

for _, desc in ipairs(Workspace:GetDescendants()) do
if desc:IsA("ProximityPrompt") then
local name = string.lower(desc.Name)
local parentName = desc.Parent and string.lower(desc.Parent.Name) or ""
if name:find("punch") or name:find("strength") or name:find("test")
or parentName:find("punch") or parentName:find("strength") or parentName:find("tester") then
CachedPrompt = desc
return desc
end
end
end
return nil
end

local function fire_prompt(prompt)
if not prompt or not prompt.Parent then return false end
if fireproximityprompt then return pcall(fireproximityprompt, prompt) end
local saved = prompt.HoldDuration
prompt.HoldDuration = 0
local ok = pcall(function()
prompt:InputHoldBegin()
task.wait(0.02)
prompt:InputHoldEnd()
end)
prompt.HoldDuration = saved
return ok
end

local function auto_start_loop()
while AutoPunchEnabled do
pcall(function()
local now = os.clock()
if now - LastFireTime < FIRE_COOLDOWN then return end
local character = LocalPlayer.Character
if not character then return end
local hrp = character:FindFirstChild("HumanoidRootPart")
if not hrp then return end
local prompt = find_punch_prompt()
if not prompt then task.wait(5) return end

local promptPart = prompt.Parent
if promptPart and promptPart:IsA("BasePart") then
local dist = (promptPart.Position - hrp.Position).Magnitude
if dist > (prompt.MaxActivationDistance or 10) then task.wait(0.5) return end
end

local inGame = false
pcall(function()
local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
if playerGui then
local punchUI = playerGui:FindFirstChild("PunchUI")
or playerGui:FindFirstChild("StrengthUI")
or playerGui:FindFirstChild("StrengthTesterUI")
if punchUI and punchUI.Enabled then inGame = true end
end
end)
if inGame then task.wait(0.3) return end
LastFireTime = now
fire_prompt(prompt)
end)
task.wait(0.5)
end
AutoStartLoop = nil
end

